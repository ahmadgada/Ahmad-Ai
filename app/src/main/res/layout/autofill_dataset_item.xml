<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="#141624">

    <ImageView
        android:id="@+id/autofill_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_autofill_shield"
        android:contentDescription="Cyber Guard" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/autofill_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cyber Guard"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/autofill_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autofill login credentials"
            android:textColor="#8F9BB3"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/autofill_lock_badge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_autofill_lock"
        android:contentDescription="Protected" />
</LinearLayout>
